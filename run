#!/usr/bin/env bash
# openclaw_sim 一键运行: 自动准备环境 → 生成模型 → 采集 3 集 → 汇总
# 可选透传参数(全部可省):
#   ./run --gui                # 打开 3D 窗口边看边采
#   ./run --brain anthropic    # 用 Claude LLM 当大脑(需 config.py 配好端点)
#   ./run --episodes 20        # 多采几集
set -euo pipefail
cd "$(dirname "$0")"
ROOT="$(pwd)"
PY="$ROOT/.venv/bin/python"

# 0. 环境自举: venv 不存在则创建并安装依赖(仅首次, 需网络)
if [ ! -x "$PY" ]; then
    echo "[run] 初始化虚拟环境..."
    uv venv "$ROOT/.venv" --python 3.12
    uv pip install --python "$PY" -r "$ROOT/requirements.txt"
fi

# 1. 组合模型缺失则生成(改过 models/*.xml 后删除 generated.xml 即可重建)
if [ ! -f models/mobile_manip.generated.xml ]; then
    echo "[run] 生成组合模型..."
    "$PY" compose_model.py > /dev/null
fi

# 2. 采集(默认: 脚本策略 3 集; 后续参数覆盖默认值)
exec "$PY" run_collect.py --brain scripted --episodes 3 --seed 0 "$@"
